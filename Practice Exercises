    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("Enter direction (1 = right, 0 = left): ");
    scanf("%d", &direction);

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nSeek Sequence: %d ", head);

    if (direction == 1)
    {
        for (i = 0; i < n; i++)
        {
            if (request[i] >= head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }

        total += abs(head - (diskSize - 1));
        head = diskSize - 1;
        printf("-> %d ", head);

        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] < head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }
    }
    else
    {
        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] <= head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }

        total += abs(head - 0);
        head = 0;
        printf("-> %d ", head);

        for (i = 0; i < n; i++)
        {
            if (request[i] > head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
