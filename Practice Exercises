6. Preemptive Priority Scheduling
#include <stdio.h>

int main()
{
    int n, i, time = 0, completed = 0;
    int bt[20], remaining[20], priority[20];
    int wt[20], tat[20];
    int highest;

    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter burst time of P%d: ", i + 1);
        scanf("%d", &bt[i]);

        printf("Enter priority of P%d: ", i + 1);
        scanf("%d", &priority[i]);

        remaining[i] = bt[i];
        wt[i] = 0;
        tat[i] = 0;
    }

    while (completed < n)
    {
        highest = -1;

        for (i = 0; i < n; i++)
        {
            if (remaining[i] > 0)
            {
                if (highest == -1 ||
                    priority[i] < priority[highest])
                {
                    highest = i;
                }
            }
        }

        if (highest == -1)
            break;

        remaining[highest]--;
        time++;

        if (remaining[highest] == 0)
        {
            completed++;
            tat[highest] = time;
            wt[highest] = tat[highest] - bt[highest];
        }
    }

    printf("\nProcess\tBT\tPriority\tWT\tTAT\n");

    for (i = 0; i < n; i++)
    {
        avg_wt += wt[i];
        avg_tat += tat[i];

        printf("P%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, bt[i], priority[i],
               wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
