8. Round Robin Scheduling
#include <stdio.h>

int main()
{
    int n, i, time = 0, quantum;
    int bt[20], remaining[20];
    int wt[20], tat[20];
    int done;

    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter burst time of P%d: ", i + 1);
        scanf("%d", &bt[i]);

        remaining[i] = bt[i];
        wt[i] = 0;
        tat[i] = 0;
    }

    printf("Enter time quantum: ");
    scanf("%d", &quantum);

    while (1)
    {
        done = 1;

        for (i = 0; i < n; i++)
        {
            if (remaining[i] > 0)
            {
                done = 0;

                if (remaining[i] > quantum)
                {
                    time += quantum;
                    remaining[i] -= quantum;
                }
                else
                {
                    time += remaining[i];

                    wt[i] = time - bt[i];
                    remaining[i] = 0;
                    tat[i] = time;
                }
            }
        }

        if (done == 1)
            break;
    }

    printf("\nProcess\tBT\tWT\tTAT\n");

    for (i = 0; i < n; i++)
    {
        avg_wt += wt[i];
        avg_tat += tat[i];

        printf("P%d\t%d\t%d\t%d\n",
               i + 1, bt[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
9. Inter-Process Communication Using Shared Memory
#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int shmid;
    char *str;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0666);

    if (shmid < 0)
    {
        printf("Shared memory creation failed\n");
        return 1;
    }

    str = (char *)shmat(shmid, NULL, 0);

    if (str == (char *)-1)
    {
        printf("Shared memory attachment failed\n");
        return 1;
    }

    if (fork() == 0)
    {
        printf("Child Process reads: %s\n", str);
        shmdt(str);
    }
    else
    {
        strcpy(str, "Hello from Parent Process");
        sleep(1);
        shmdt(str);
    }

    shmctl(shmid, IPC_RMID, NULL);

    return 0;
}
