    printf("\nSeek Sequence: %d ", head);

    if (direction == 1)
    {
        for (i = 0; i < n; i++)
        {
            if (request[i] >= head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }

        total += abs(head - (diskSize - 1));
        head = diskSize - 1;
        printf("-> %d ", head);

        total += diskSize - 1;
        head = 0;
        printf("-> %d ", head);

        for (i = 0; i < n; i++)
        {
            if (request[i] < head)
                continue;

            if (request[i] >= 0)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }
    }
    else
    {
        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] <= head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }

        total += head;
        head = 0;
        printf("-> %d ", head);

        total += diskSize - 1;
        head = diskSize - 1;
        printf("-> %d ", head);

        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] > head)
                continue;

            if (request[i] >= 0)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf("-> %d ", head);
            }
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
40. Linux File Access Permissions and User Types
#include <stdio.h>
#include <sys/stat.h>
#include <unistd.h>

int main()
{
    struct stat st;
    char filename[100];

    printf("Enter filename: ");
    scanf("%s", filename);

    if (stat(filename, &st) != 0)
    {
        printf("File not found\n");
        return 1;
    }

    printf("\nFile Permissions:\n");

    printf("Owner: ");

    if (st.st_mode & S_IRUSR)
        printf("Read ");

    if (st.st_mode & S_IWUSR)
        printf("Write ");

    if (st.st_mode & S_IXUSR)
        printf("Execute ");

    printf("\nGroup: ");

    if (st.st_mode & S_IRGRP)
        printf("Read ");

    if (st.st_mode & S_IWGRP)
        printf("Write ");

    if (st.st_mode & S_IXGRP)
        printf("Execute ");

    printf("\nOthers: ");

    if (st.st_mode & S_IROTH)
        printf("Read ");

    if (st.st_mode & S_IWOTH)
        printf("Write ");

    if (st.st_mode & S_IXOTH)
        printf("Execute ");

    printf("\n");

    return 0;
}
