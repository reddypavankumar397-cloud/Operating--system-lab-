2. Bitmap Disk Space Management
#include <stdio.h>


int main() {
    int n, bitmap[100], request;
    int i, count = 0, block;


    printf("Enter number of disk blocks: ");
    scanf("%d", &n);


    printf("Enter bitmap (0=free, 1=allocated):\n");
    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);


    printf("Enter number of blocks to allocate: ");
    scanf("%d", &request);


    for (i = 0; i < n && count < request; i++) {
        if (bitmap[i] == 0) {
            bitmap[i] = 1;
            count++;
        }
    }


    if (count < request) {
        printf("Not enough free blocks\n");
    } else {
        printf("Allocation successful\n");
    }


    printf("Bitmap after allocation:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);


    printf("\nEnter block number to deallocate (-1 to stop):\n");


    while (1) {
        scanf("%d", &block);


        if (block == -1)
            break;


        if (block >= 0 && block < n && bitmap[block] == 1) {
            bitmap[block] = 0;
            printf("Block %d deallocated\n", block);
        } else {
            printf("Invalid or already free block\n");
        }
    }


    printf("Final bitmap:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);


    return 0;
}
