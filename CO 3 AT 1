1. Base and Limit Register
Program
#include <stdio.h>

int main() {
    int base, limit, logical;

    printf("Enter Base Address: ");
    scanf("%d", &base);

    printf("Enter Limit: ");
    scanf("%d", &limit);

    printf("Enter Logical Address: ");
    scanf("%d", &logical);

    if (logical < limit)
        printf("Physical Address = %d", base + logical);
    else
        printf("Invalid Address");

    return 0;
}
Sample Output
Enter Base Address: 1000
Enter Limit: 500
Enter Logical Address: 200
Physical Address = 1200
2. Paging Address Translation
