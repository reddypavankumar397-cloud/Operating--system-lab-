4. TLB Effective Memory Access Time
Program
#include <stdio.h>

int main() {
    float hitRatio, memoryTime, emat;

    printf("Enter Hit Ratio: ");
    scanf("%f", &hitRatio);

    printf("Enter Memory Access Time: ");
    scanf("%f", &memoryTime);

    emat = hitRatio * memoryTime + (1 - hitRatio) * (2 * memoryTime);

    printf("Effective Memory Access Time = %.2f", emat);

    return 0;
}
Sample Output
Enter Hit Ratio: 0.8
Enter Memory Access Time: 100
Effective Memory Access Time = 120.00
5. Memory Protection
Program
#include <stdio.h>

int main() {
    int base, limit, address;

    printf("Enter Base: ");
    scanf("%d", &base);

    printf("Enter Limit: ");
    scanf("%d", &limit);

    printf("Enter Address: ");
    scanf("%d", &address);

    if (address >= base && address < base + limit)
        printf("Access Allowed");
    else
        printf("Access Denied");

    return 0;
}
Sample Output
Enter Base: 1000
Enter Limit: 500
Enter Address: 1200
Access Allowed
